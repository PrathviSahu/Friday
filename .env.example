# ─────────────────────────────────────────────────────────────
#  F.R.I.D.A.Y. Docker configuration
#  Copy this file to `.env` and fill in the values, then run:
#      docker compose up -d --build
# ─────────────────────────────────────────────────────────────

# ── AI keys (both are used; Groq is the primary brain) ──────
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# ── API token — REQUIRED for Docker ─────────────────────────
# In Docker every request arrives from the container bridge
# network (not loopback), so all API access is gated by this
# token. Generate one, e.g.  `openssl rand -hex 24`  or
# PowerShell:  [guid]::NewGuid().ToString("N")+[guid]::NewGuid().ToString("N")
# The same value is baked into the frontend build automatically.
FRIDAY_API_TOKEN=change_me_to_a_long_random_string

# ── Spotify (optional) ──────────────────────────────────────
# Friday's zero-config anonymous web-player token works without
# these; set them for a more stable account-bound connection.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Optional integrations ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
FRIDAY_VAULT_KEY=

# ── Email Agent (Gmail / Outlook) ───────────────────────────
# Gmail:  host=imap.gmail.com, smtp=smtp.gmail.com:587, use an
#         App Password (Google Account → Security → App passwords).
# Outlook: host=outlook.office365.com, smtp=smtp.office365.com:587.
# Reading needs permission email.read; sending always asks first.
FRIDAY_EMAIL_HOST=
FRIDAY_EMAIL_IMAP_PORT=993
FRIDAY_EMAIL_SMTP_HOST=
FRIDAY_EMAIL_SMTP_PORT=587
FRIDAY_EMAIL_USER=
FRIDAY_EMAIL_PASS=

# ── Calendar Agent (Google Calendar) ──────────────────────
# Uses the same Google OAuth setup as GDrive: create a Google Cloud
# OAuth client with the Calendar API enabled and save it as
# backend/credentials.json. Friday creates calendar_token.json on
# first use (own token, calendar scopes).
# Reading needs permission calendar.read; creating always asks first.

# ── Image options ───────────────────────────────────────────
# 1 = install Playwright Chromium in the backend image for
#     career job scraping AND the WhatsApp driver (~400 MB larger)
INSTALL_BROWSERS=0

# ── WhatsApp (EXPERIMENTAL) ─────────────────────────────────
# No official free API exists, so FRIDAY drives WhatsApp Web
# with its own Playwright driver (opt-in). Requires Playwright
# Chromium (INSTALL_BROWSERS=1 in Docker). WhatsApp can change
# its UI at any time — treat as experimental. Always asks
# before sending (whatsapp.send = ask).
FRIDAY_WHATSAPP_ENABLED=0
