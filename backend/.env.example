# Copy this file to backend/.env and fill in your keys.

# ── LLM Brain ────────────────────────────────────────────────────────────────
# Groq powers the primary voice brain (Llama 3.3 70B) + v3 function calling.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Google Gemini — fallback engine + career AI. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Owner authentication ─────────────────────────────────────────────────────
# FRIDAY trusts requests from localhost. Requests from any other machine
# (e.g. your LAN) must send this value as the `X-FRIDAY-Token` header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FRIDAY_API_TOKEN=your_key_here

# Optional: encryption key for the Career OS credential vault (Fernet key).
# If unset, a key file is auto-generated at backend/data/.vault_key on first
# use. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FRIDAY_VAULT_KEY=

# ── Spotify Web API (for song search & play) ────────────────────────────────
# Create a Spotify Developer App at: https://developer.spotify.com/dashboard
# Add redirect URI: http://localhost:8888/callback
# Then run:  python backend/spotify_auth_setup.py
# That script will auto-fill SPOTIFY_REFRESH_TOKEN below.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=generated_by_spotify_auth_setup_py

# ── Spotify Playlist URIs (optional overrides) ───────────────────────────────
# SPOTIFY_PLAYLIST_HINDI=spotify:playlist:4SuEAsJ6ulS62RYJk88Sap
# SPOTIFY_PLAYLIST_ENGLISH=spotify:playlist:2CCKzQqgsc50gtJeYDonJh
# SPOTIFY_PLAYLIST_KRISHNA=spotify:playlist:3Fd9z849SrTBEtHDTgQvXo

# ── Telegram Bot (v3 remote access) ─────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → copy the token.
# 2. Find your numeric user id (talk to @userinfobot) — only this id may use
#    the bot; everyone else gets "⛔ Access denied".
# 3. Run:  python -m services.telegram_bot   (from backend/)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# ── Speech-to-text (optional) ────────────────────────────────────────────────
# STT_PROVIDER_MODE=smart        # smart | openai | faster_whisper
# STT_OFFLINE_MODE=false
# WHISPER_MODEL=base
